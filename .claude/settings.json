{
  "permissions": {
    "allow": [
      "Bash(npm run build:*)",
      "Bash(npm run test:*)",
      "Bash(npm run lint:*)",
      "Bash(npm run format:*)",
      "Bash(graphify query:*)",
      "Bash(graphify explain:*)",
      "Bash(graphify path:*)",
      "Bash(graphify update:*)",
      "mcp__codebase-memory-mcp__search_graph",
      "mcp__codebase-memory-mcp__trace_path",
      "mcp__codebase-memory-mcp__get_code_snippet",
      "mcp__codebase-memory-mcp__query_graph",
      "mcp__codebase-memory-mcp__get_architecture",
      "mcp__codebase-memory-mcp__search_code",
      "mcp__codebase-memory-mcp__index_status",
      "mcp__codebase-memory-mcp__detect_changes"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "command -v graphify >/dev/null 2>&1 && graphify hook-guard search || exit 0"
          }
        ]
      },
      {
        "matcher": "Read|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "command -v graphify >/dev/null 2>&1 && graphify hook-guard read || exit 0"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "command -v graphify >/dev/null 2>&1 || exit 0; f=$(node -e 'let d=\"\";process.stdin.on(\"data\",c=>d+=c);process.stdin.on(\"end\",()=>{try{const t=JSON.parse(d).tool_input;process.stdout.write((t&&t.file_path)||\"\")}catch(e){}})'); case \"$f\" in *.ts) graphify update . >/dev/null 2>&1;; esac; exit 0",
            "timeout": 30
          }
        ]
      }
    ]
  }
}